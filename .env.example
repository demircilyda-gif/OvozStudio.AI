# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL=""

# ADMIN_EMAILS: Comma-separated admin email addresses for privileged operations.
ADMIN_EMAILS=""

# STRIPE_SECRET_KEY: Optional. For live or test Stripe Checkout payments (e.g. sk_test_... or sk_live_...).
STRIPE_SECRET_KEY=""

# STRIPE_WEBHOOK_SECRET: Optional. Secret for verifying Stripe webhook events.
STRIPE_WEBHOOK_SECRET=""

# TELEGRAM_ADMIN_HANDLE: Admin Telegram username or link for manual payment confirmation (e.g. @admin_handle).
TELEGRAM_ADMIN_HANDLE=""

# ADMIN_PHONE_NUMBER: Contact phone number for manual payment inquiries.
ADMIN_PHONE_NUMBER=""

# ADMIN_CARD_NUMBER: Card number for money transfers (Uzcard / Humo)
ADMIN_CARD_NUMBER=""
ADMIN_CARD_HOLDER=""
ADMIN_CARD_BANK=""
