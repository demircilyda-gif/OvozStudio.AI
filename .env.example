# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# STRIPE_SECRET_KEY: Optional. For live or test Stripe Checkout payments (e.g. sk_test_... or sk_live_...).
# When set, users can pay directly via Stripe Checkout with Visa, Mastercard, Apple Pay, Google Pay.
STRIPE_SECRET_KEY=""

# STRIPE_WEBHOOK_SECRET: Optional. Secret for verifying Stripe webhook events.
STRIPE_WEBHOOK_SECRET=""

# TELEGRAM_ADMIN_HANDLE: Admin Telegram username or link for manual payment confirmation (e.g. @ovozstudio_admin).
TELEGRAM_ADMIN_HANDLE="ovozstudio_admin"

# ADMIN_PHONE_NUMBER: Contact phone number for manual payment inquiries.
ADMIN_PHONE_NUMBER="+998 90 123 45 67"

# ADMIN_CARD_NUMBER: Card number for money transfers (Uzcard / Humo)
ADMIN_CARD_NUMBER="9860 3501 4500 1755"
ADMIN_CARD_HOLDER="HUMO"
ADMIN_CARD_BANK="Humo"

